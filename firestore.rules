rules_version = '2';

// The public application is server-authoritative. The browser never receives
// direct Firestore access; Firebase Admin performs all reads/writes after the
// Express API has validated the anonymous capability token and resource limits.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
